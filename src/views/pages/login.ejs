<section class="login-premium">
  <div class="login-card">
    <a href="/" class="login-logo">
      <span>BF</span>
      <div>
        <strong>BARBERFLOW</strong>
        <small>BARBERÍA PREMIUM</small>
      </div>
    </a>

    <h1>Ingresar</h1>
    <p>Accede al panel de administración de la barbería.</p>

    <form id="loginForm">
      <label>Correo</label>
      <input name="email" type="email" placeholder="admin@barberflow.cl" required>

      <label>Contraseña</label>
      <input name="password" type="password" placeholder="Contraseña" required>

      <button type="submit">Ingresar</button>
    </form>

    <div class="login-help">
      <span>Admin:</span> admin@barberflow.cl / admin123
    </div>

    <div id="authMsg"></div>
  </div>
</section>
