<section class="auth-page">
  <form class="auth-card" id="loginForm">
    <a href="/" class="brand auth-brand">BarberFlow</a>
    <h1>Ingresar</h1>
    <p>Accede según tu perfil: administrador, barbero o cliente.</p>

    <label>Correo</label>
    <input name="email" type="email" placeholder="correo@barberflow.cl" required>

    <label>Contraseña</label>
    <input name="password" type="password" placeholder="••••••••" required>

    <button class="btn gold w-100">Ingresar</button>

    <small>¿No tienes cuenta? <a href="/register">Crear cuenta</a></small>
    <div id="authMsg"></div>
  </form>
</section>
