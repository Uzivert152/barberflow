    <form id="publicBookingForm" class="booking-form">
      <input name="client_name" placeholder="Nombre completo" required>
      <input name="client_email" type="email" placeholder="Correo electrónico">
      <input name="client_phone" placeholder="Teléfono / WhatsApp" required>

      <select name="service_id" id="publicServices" required></select>
      <select name="barber_id" id="publicBarbers" required></select>

      <input name="booking_date" type="date" required>

      <select name="booking_time" required>
        <option value="">Seleccionar hora</option>
