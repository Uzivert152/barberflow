<section class="auth-page">
  <form class="auth-card" id="registerForm">
    <a href="/" class="brand auth-brand">BarberFlow</a>
    <h1>Crear cuenta</h1>
    <p>Crea acceso para administrador o cliente.</p>

    <label>Tipo de cuenta</label>
    <select name="role">
      <option value="admin">Administrador barbería</option>
      <option value="client">Cliente</option>
    </select>

    <label>Nombre barbería</label>
    <input name="barbershop_name" placeholder="Ej: Gentleman Barber Club">

    <label>Nombre</label>
    <input name="name" placeholder="Tu nombre" required>

    <label>Correo</label>
    <input name="email" type="email" placeholder="correo@barberflow.cl" required>

    <label>Contraseña</label>
    <input name="password" type="password" placeholder="Contraseña" required>

    <button class="btn gold w-100">Crear cuenta</button>
    <small>¿Ya tienes cuenta? <a href="/login">Ingresar</a></small>
    <div id="authMsg"></div>
  </form>
</section>
