<section class="auth-page">
  <form class="auth-card" id="registerForm">
    <a href="/" class="brand auth-brand">BarberFlow</a>

    <span class="eyebrow">Cuenta cliente</span>

    <h1>Crear cuenta</h1>

    <p>
      Crea tu cuenta para recibir códigos de descuento, promociones y beneficios especiales.
    </p>

    <input type="hidden" name="role" value="client">

    <label>Nombre</label>
    <input name="name" placeholder="Tu nombre" required>

    <label>Correo</label>
    <input name="email" type="email" placeholder="correo@ejemplo.com" required>

    <label>Contraseña</label>
    <input name="password" type="password" placeholder="Contraseña" required>

    <div class="discount-box">
      <strong>Código de bienvenida</strong>
      <span>NUEVO10 · 10% de descuento en tu próxima visita.</span>
    </div>

    <button class="btn gold w-100">Crear cuenta cliente</button>

    <small>¿Ya tienes cuenta? <a href="/login">Ingresar</a></small>

    <div id="authMsg"></div>
  </form>
</section>
